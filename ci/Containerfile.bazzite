ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck:stable

FROM scratch AS ctx
COPY target-rpms /rpms
COPY tests/test-dracut-bazzite.sh /tests/test-dracut-bazzite.sh

FROM ${BASE_IMAGE}

# Install local RPMs via read-only bind mount and ephemeral cache/tmpfs mounts so
# build-time caches, logs, and /run state do not persist in image layers.
RUN --mount=type=bind,from=ctx,source=/rpms,target=/tmp/rpms,ro \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/run \
    --mount=type=tmpfs,dst=/tmp \
    dnf5 install -y /tmp/rpms/*.rpm

# Run synthetic dracut test with outputs in tmpfs so test initramfs does not persist
RUN --mount=type=bind,from=ctx,source=/tests,target=/tmp/tests,ro \
    --mount=type=tmpfs,target=/tmp/work \
    /bin/bash /tmp/tests/test-dracut-bazzite.sh /tmp/work

# Perform static bootc structural validation
RUN bootc container lint
